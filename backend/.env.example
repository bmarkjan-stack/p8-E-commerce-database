# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Full Postgres connection string.
# Local:            postgresql://postgres:postgres@localhost:5433/ecommerce_db
# Docker Compose:    postgresql://postgres:postgres@db:5433/ecommerce_db
# Hosted (Neon/Supabase/Railway): use the connection string they give you
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce_db

# Set to true only when connecting to a hosted DB that requires SSL
DATABASE_SSL=false

# Secret used to sign JWTs. Generate a long random string for production,
# e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
